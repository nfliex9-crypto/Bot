ENV=prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DSN=postgresql+psycopg2://trader:trader@db:5432/trading

TRADING_MODE=paper
POLLING_SECONDS=60

ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3

STOP_LOSS_MODE=atr
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
STRUCTURE_PADDING=0.0002

TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=1.5
TP3_R_MULTIPLE=2.0

SESSION_LONDON_START=7
SESSION_LONDON_END=17
SESSION_NEWYORK_START=8
SESSION_NEWYORK_END=17

NEWS_FILTER_ENABLED=true
NEWS_COOLDOWN_MINUTES=30
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
HIGH_IMPACT_ONLY=true

FOREX_SYMBOLS=["EURUSD","GBPUSD"]
CRYPTO_SYMBOLS=["BTCUSDT","ETHUSDT"]

# LIVE MODE CREDENTIALS
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

MODEL_PATH=models/random_forest.joblib
MIN_TRAINING_SAMPLES=50
MIN_CONFIDENCE_TO_TRADE=0.55

