APP_NAME=AI Automated Trading System
ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg2://trader:trader@postgres:5432/trading
TRADING_ENABLED=false
TRADE_LOOP_SECONDS=60

RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3
ATR_PERIOD=14

INITIAL_EQUITY=100000

AI_CONFIDENCE_THRESHOLD=0.55
MODEL_PATH=app/models/random_forest.joblib

FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
