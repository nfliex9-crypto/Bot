# ══════════════════════════════════════════════
# AI Trading System — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════

# ─── Application ────────────────────────────
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-string-min-32-chars

# ─── Database ───────────────────────────────
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_pass
POSTGRES_DB=trading_db

# ─── Binance API ────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true    # Set false for live trading

# ─── MetaTrader 5 ───────────────────────────
# MT5 only works on Windows. On Linux it runs in simulation mode.
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=                # Optional: path to MT5 terminal executable

# ─── Risk Parameters ────────────────────────
RISK_PER_TRADE_PCT=0.75       # % of account risked per trade
MAX_DRAWDOWN_PCT=15.0          # Max drawdown before trading halts
MAX_TRADES_PER_SESSION=3       # Max trades per trading session
TP1_RATIO=1.5                  # TP1 = 1.5 × SL distance
TP2_RATIO=2.5                  # TP2 = 2.5 × SL distance
TP3_RATIO=4.0                  # TP3 = 4.0 × SL distance

# ─── AI Model ───────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.65  # Minimum AI confidence to execute a trade

# ─── pgAdmin (dev only) ─────────────────────
PGADMIN_EMAIL=admin@trading.local
PGADMIN_PASSWORD=admin123
