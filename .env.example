PROJECT_NAME=AI Automated Trading System
APP_ENV=development
DEBUG=false
ENABLE_BACKGROUND_LOOP=true
LOOP_INTERVAL_SECONDS=60
PAPER_TRADING=true

DATABASE_URL=postgresql+psycopg2://trader:trader@postgres:5432/trading

RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3
DEFAULT_ACCOUNT_EQUITY=100000
MIN_CONFIDENCE_THRESHOLD=0.6

DEFAULT_TIMEFRAME=M15
CANDLE_LIMIT=250
AI_MIN_TRAINING_SAMPLES=25

FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

ALLOWED_CORS_ORIGINS=["http://localhost:8080","http://localhost:3000","http://localhost:8000"]
