# ── Trading Mode ──────────────────────────────────────────────
TRADING_MODE=paper          # paper | live

# ── MetaTrader 5 ─────────────────────────────────────────────
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server
MT5_PATH=/path/to/terminal64.exe

# ── Binance ──────────────────────────────────────────────────
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
BINANCE_TESTNET=true

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trading_bot
DATABASE_URL_SYNC=postgresql+psycopg2://trader:trader@localhost:5432/trading_bot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Risk Management ─────────────────────────────────────────
ACCOUNT_BALANCE=3000.0
RISK_PER_TRADE=0.75
MAX_DRAWDOWN_PCT=15.0
MAX_TRADES_PER_SESSION=3

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── News Filter ──────────────────────────────────────────────
FOREX_FACTORY_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
