# ─── Trading Mode ────────────────────────────────────────────────────────────
# Options: paper | live
TRADING_MODE=paper

# ─── Account Configuration ───────────────────────────────────────────────────
ACCOUNT_BALANCE=3000.0
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN_PCT=0.15
MAX_TRADES_PER_SESSION=3

# ─── MetaTrader5 (Forex) ─────────────────────────────────────────────────────
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Forex symbols to trade
MT5_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,GBPJPY,EURJPY

# ─── Binance (Crypto) ────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# Crypto symbols to trade
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,ADAUSDT

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=trading_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=securepassword
DATABASE_URL=postgresql+asyncpg://trader:securepassword@localhost:5432/trading_bot
DATABASE_SYNC_URL=postgresql://trader:securepassword@localhost:5432/trading_bot

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── News Filter ─────────────────────────────────────────────────────────────
NEWS_API_KEY=your_forexfactory_or_investing_api_key
NEWS_BLACKOUT_MINUTES=30

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ─── API ─────────────────────────────────────────────────────────────────────
API_SECRET_KEY=change_this_to_a_secure_random_string
API_HOST=0.0.0.0
API_PORT=8000
