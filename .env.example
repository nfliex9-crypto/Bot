# =============================================================
# AI Trading Bot — Environment Configuration
# Copy this file to .env and fill in your credentials
# =============================================================

# ---- Trading Mode ----
TRADING_MODE=paper          # "paper" or "live"
LOG_LEVEL=INFO

# ---- Account Settings ----
ACCOUNT_BALANCE=3000.0
RISK_PER_TRADE=0.0075       # 0.75%
MAX_DRAWDOWN=0.15            # 15%
MAX_TRADES_PER_SESSION=3

# ---- Database ----
DB_HOST=db
DB_PORT=5432
DB_USER=trading
DB_PASSWORD=trading_secret
DB_NAME=trading_bot
DATABASE_URL=postgresql+asyncpg://trading:trading_secret@db:5432/trading_bot

# ---- Binance (Crypto) ----
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true        # "true" for paper, "false" for live

# ---- MetaTrader 5 (Forex) ----
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=                   # Optional: path to terminal64.exe on Windows

# ---- News API (optional, for high-impact news filter) ----
NEWS_API_KEY=your_forexfactory_or_investing_api_key
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_long_random_secret

# ---- PgAdmin ----
PGADMIN_EMAIL=admin@trading.local
PGADMIN_PASSWORD=admin

# ---- Session Filter ----
LONDON_OPEN_UTC=07:00
LONDON_CLOSE_UTC=16:00
NEW_YORK_OPEN_UTC=13:00
NEW_YORK_CLOSE_UTC=22:00

# ---- Strategy Symbols ----
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
