# Trading Mode: paper or live
TRADING_MODE=paper

# Database (sqlite for local dev, postgres for Docker)
DATABASE_URL=sqlite:///./trading.db
# DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_bot

# Risk Management
ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.75
MAX_DRAWDOWN=15
MAX_TRADES_PER_SESSION=3

# MT5 (Forex)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Binance (Crypto)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
