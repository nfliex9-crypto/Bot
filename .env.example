APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
POLLING_SECONDS=60

# Trading mode: paper | live
TRADING_MODE=paper

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/trading_bot

# Risk profile
ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3

# Strategy / execution
SYMBOLS_FOREX=EURUSD,GBPUSD,USDJPY
SYMBOLS_CRYPTO=BTCUSDT,ETHUSDT
TIMEFRAME_BIAS=H1
TIMEFRAME_STRUCTURE=M15
TIMEFRAME_EXECUTION=M5
USE_STRUCTURE_STOP=false
ATR_PERIOD=14
ATR_MULTIPLIER=1.5

# Session settings (UTC)
LONDON_START_HOUR=7
LONDON_END_HOUR=16
NEWYORK_START_HOUR=12
NEWYORK_END_HOUR=21

# News filter
ENABLE_NEWS_FILTER=true
NEWS_LOOKAHEAD_MINUTES=45
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# MT5 live execution
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Binance live execution
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ML model artifacts
MODEL_PATH=artifacts/random_forest_model.joblib
SCALER_PATH=artifacts/feature_scaler.joblib
