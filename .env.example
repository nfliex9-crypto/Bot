APP_NAME=AI Trading Bot System
ENVIRONMENT=prod
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/trading

MODE=paper
AUTO_START_ENGINE=true
POLLING_INTERVAL_SECONDS=30
SYMBOLS_FOREX=["EURUSD","GBPUSD"]
SYMBOLS_CRYPTO=["BTCUSDT","ETHUSDT"]

ACCOUNT_BALANCE=3000
RISK_PER_TRADE_PCT=0.75
MAX_DRAWDOWN_PCT=15
MAX_TRADES_PER_SESSION=3

STOP_TYPE=atr
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
NEWS_BLOCK_WINDOW_MINUTES=60

MODEL_PATH=models/random_forest.joblib
MIN_CONFIDENCE_TO_TRADE=0.55

# MT5 live config (required for live forex execution)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Binance config (required for live crypto execution)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
