APP_NAME=AI Automated Trading Bot
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/trading_bot
MODEL_STORE_PATH=data/confidence_model.joblib

MODE=paper
STOP_METHOD=atr
BOT_ENABLED=true
CYCLE_INTERVAL_SECONDS=60

ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3
MAX_CONCURRENT_TRADES=4
CONFIDENCE_THRESHOLD=0.58

LONDON_SESSION_START_UTC=7
LONDON_SESSION_END_UTC=11
NEW_YORK_SESSION_START_UTC=13
NEW_YORK_SESSION_END_UTC=17

NEWS_BLOCK_WINDOW_MINUTES=30
HIGH_IMPACT_NEWS_URL=
HIGH_IMPACT_NEWS_API_KEY=

FOREX_SYMBOLS=["EURUSD","GBPUSD","USDJPY"]
CRYPTO_SYMBOLS=["BTCUSDT","ETHUSDT"]

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
