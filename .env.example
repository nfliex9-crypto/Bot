# ===========================================
# AI Trading Bot — Environment Configuration
# ===========================================

# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# ---- MetaTrader 5 (Forex) ----
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=10000

# ---- Binance (Crypto) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trader
DB_PASSWORD=trader_pass

# ---- Risk Management ----
ACCOUNT_BALANCE=3000.0
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_SESSION=3
MAX_DAILY_LOSS=0.05

# ---- Strategy Tuning ----
LIQ_LOOKBACK=50
STRUCT_LOOKBACK=30
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
MIN_CONFIDENCE=0.65

# ---- News Filter ----
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_MINUTES_BEFORE=30
NEWS_MINUTES_AFTER=30

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
