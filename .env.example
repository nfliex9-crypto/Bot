# App
APP_NAME=ai-trading-system
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trading
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Trading
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3
SESSION_NAME=london
DEFAULT_SYMBOL=EURUSD
DEFAULT_MARKET=forex
PAPER_MODE=true

# MetaTrader5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Frontend
FLUTTER_API_BASE_URL=http://localhost:8000
