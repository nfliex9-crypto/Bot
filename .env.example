APP_NAME=AI Trading Bot
DATABASE_URL=postgresql+psycopg://trader:trader@db:5432/trading_bot
BOT_MODE=paper
BOT_ENABLED_ON_STARTUP=true
LOOP_INTERVAL_SECONDS=30
INITIAL_ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3
MIN_CONFIDENCE=0.58
SYMBOLS_FOREX=EURUSD,GBPUSD
SYMBOLS_CRYPTO=BTC/USDT,ETH/USDT
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_SYNC_URL=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MODEL_PATH=artifacts/random_forest.joblib
