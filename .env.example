# ============================================================
# AI Trading Bot - Environment Configuration
# ============================================================

# Application
APP_NAME="AI Trading Bot"
VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# Database
DATABASE_URL=postgresql://trader:trading_password@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

# ============================================================
# MetaTrader 5 (Forex)
# ============================================================
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ============================================================
# Binance (Crypto)
# ============================================================
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
# Set to true for testnet (paper trading), false for live
BINANCE_TESTNET=true

# ============================================================
# Risk Management
# ============================================================
ACCOUNT_BALANCE=3000.0
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3

# ============================================================
# AI Configuration
# ============================================================
MODEL_PATH=/app/models/rf_classifier.pkl
MIN_CONFIDENCE=0.65
RETRAIN_INTERVAL_HOURS=24

# ============================================================
# News Filter
# ============================================================
NEWS_API_KEY=your_news_api_key
NEWS_FILTER_MINUTES_BEFORE=30
NEWS_FILTER_MINUTES_AFTER=30

# ============================================================
# Session Filter
# ============================================================
# London: 08:00-16:00 UTC, New York: 13:00-21:00 UTC
LONDON_OPEN_UTC=8
LONDON_CLOSE_UTC=16
NEW_YORK_OPEN_UTC=13
NEW_YORK_CLOSE_UTC=21

# ============================================================
# Forex Pairs
# ============================================================
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,GBPJPY,EURJPY

# ============================================================
# Crypto Pairs
# ============================================================
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# ============================================================
# Scan Intervals (seconds)
# ============================================================
SCAN_INTERVAL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=30
