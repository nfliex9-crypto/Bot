APP_NAME=AI Trading Bot
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trading_bot

TRADING_MODE=paper
WORKER_POLL_SECONDS=60
CONFIDENCE_THRESHOLD=0.58

ACCOUNT_BALANCE=3000
RISK_PER_TRADE=0.0075
MAX_DRAWDOWN=0.15
MAX_TRADES_PER_SESSION=3

STOP_METHOD=atr
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
STRUCTURE_BUFFER_ATR=0.15

FOREX_SYMBOLS=EURUSD,GBPUSD
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
CANDLE_LIMIT=300

NEWS_FILTER_ENABLED=true
NEWS_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30
NEWS_FAIL_OPEN=true

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_FUTURES=true

MT5_CONNECTION_MODE=bridge
MT5_BRIDGE_URL=http://host.docker.internal:8081
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

MODEL_PATH=runtime/models/random_forest.joblib
MIN_TRAINING_SAMPLES=40
MAX_TRAINING_ROWS=2000

PAPER_SLIPPAGE_BPS=2
PAPER_FEE_BPS=4
